# 用法: cp config.env.example config.env，然后填写下面的值
# config.env 含私密信息，已在 .gitignore 中排除，切勿提交到仓库

# --- 必填：用 ./lookup.sh 查出来 ---
COMPARTMENT_ID=""                          # 根区间 = 租户 OCID (ocid1.tenancy.oc1..xxxx)
AVAILABILITY_DOMAIN="uMAA:AP-SINGAPORE-1-AD-1"
SUBNET_ID=""                               # qdii-public-subnet 的 OCID
IMAGE_ID=""                                # Ubuntu aarch64 镜像 OCID
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/oci_qdii.pub"

# --- 机器规格 (Always Free 总额度: 2 OCPU / 12GB，脚本会拒绝超额) ---
INSTANCE_NAME="qdii-arm"
OCPUS=1
MEMORY_GB=6
BOOT_VOLUME_GB=50                          # 最小 47，免费总存储 200GB

# --- 重试节奏 ---
INTERVAL_SEC=90                            # 两次尝试的间隔，最低 60，避免被限流
JITTER_SEC=30                              # 随机抖动 1~N 秒
MAX_ATTEMPTS=0                             # 0 = 不限次数
MAX_UNKNOWN_ERRORS=5                       # 连续遇到非容量类错误几次后放弃

# --- 可选: Telegram 通知，不填则不通知 ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
